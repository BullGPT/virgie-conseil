# Envoi des demandes de contact (src/app/api/contact/route.ts)
#
# Copier ce fichier en .env.local et renseigner les trois valeurs.
# Sans elles : en développement la demande est tracée dans la console du
# serveur et le parcours fonctionne ; en production la route renvoie une
# erreur au visiteur plutôt que de perdre la demande en silence.

# Clé d'API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Adresse du cabinet qui reçoit les demandes
CONTACT_TO_EMAIL=

# Expéditeur. Le domaine doit être vérifié chez Resend,
# ex. "Vigie <contact@vigie.fr>"
CONTACT_FROM_EMAIL=
